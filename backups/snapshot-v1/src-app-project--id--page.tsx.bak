const ICON_ENTRIES: { label: string; outline: LucideIcon; solid: string }[] = [
  { label: "Home", outline: Home, solid: "home" },
  { label: "Search", outline: Search, solid: "search" },
  { label: "Settings", outline: Settings, solid: "settings" },
  { label: "Profile", outline: User, solid: "profile" },
  { label: "Notification", outline: Bell, solid: "notification" },
  { label: "Favorite", outline: Heart, solid: "favorite" },
  { label: "Ratings", outline: Star, solid: "ratings" },
  { label: "Arrow Up", outline: ArrowUp, solid: "arrow up" },
  { label: "Checkmark", outline: Check, solid: "checkmark" },
  { label: "Close", outline: CloseIcon, solid: "close" },
  { label: "Navigation", outline: Menu, solid: "navigation" },
  { label: "Create New", outline: Plus, solid: "create new" },
]

function SolidIcon({ name, className }: { name: string; className?: string }) {
  const icon = SOLID_PATHS[name]
  if (!icon) return null
  return (
    <svg
      viewBox="0 0 24 24"
      className={className}
      fill="currentColor"
      fillRule={icon.fillRule || "nonzero"}
      aria-hidden="true"
    >
      <path d={icon.d} />
    </svg>
  )
}

const SIZING_TARGETS = [
  { size: 16, square: 32 },
  { size: 20, square: 36 },
  { size: 24, square: 40 },
  { size: 32, square: 48 },
  { size: 40, square: 56 },
  { size: 48, square: 64 },
]

const SEMANTIC_COLORS = [
  { color: "#4F46E5", label: "Primary Icon Action", purpose: "Interactive links" },
  { color: "#475569", label: "Secondary Normal icon", purpose: "Standard status indicators" },
  { color: "#94A3B8", label: "Disabled/Quiet Icon state", purpose: "Unavailable choices" },
  { color: "#EF4444", label: "Destructive alert feedback", purpose: "Caution alert tags" },
]

function IconographySection({ d }: { d: DesignData }) {
  const icon = d.tokens?.iconography || {}
  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p className="text-xs text-[#4F46E5] font-semibold uppercase tracking-[0.2em]">06 / FOUNDATION</p>
          <h1 className="mt-1 text-2xl sm:text-3xl font-bold text-[#1E1B4B]" style={SERIF}>Iconography System Standards</h1>
        </div>
        <div className="flex items-center gap-3">
          <Badge variant="secondary" className="bg-[#EEF2F6] text-[#4F46E5] rounded-full text-xs font-bold">{icon.version || d.version || "v2.0.0"}</Badge>
          <span className="text-xs text-muted-foreground">Frame 6 of 6</span>
        </div>
      </div>
      <Separator />

      <div>
        <h3 className="font-bold text-base">Core Interface Icon Sets</h3>
        <p className="text-xs text-muted-foreground mt-0.5">Primary controls and navigation markers shown in both outlines and filled treatments.</p>
        <div className="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
          {ICON_ENTRIES.map(({ label, outline: Outline, solid }) => (
            <div key={label} className="border border-[#E2E8F0] rounded-lg bg-white p-4 text-center">
              <div className="flex items-center justify-center gap-3">
                <Outline className="h-6 w-6 text-slate-700" strokeWidth={2} />
                <SolidIcon name={solid} className="h-6 w-6 text-slate-700" />
              </div>
              <p className="mt-3 text-xs font-medium text-slate-600">{label}</p>
            </div>
          ))}
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h3 className="font-bold text-base">Icon Sizing Targets</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Consistent scaling options preventing icon bloat.</p>
          <div className="mt-4 rounded-xl border bg-card p-5">
            <div className="flex flex-wrap items-end justify-center gap-4">
              {SIZING_TARGETS.map((t) => (
                <div key={t.size} className="flex flex-col items-center gap-2">
                  <div
                    className="inline-flex items-center justify-center rounded-md border border-[#E2E8F0] bg-[#EEF2F6]"
                    style={{ width: t.square, height: t.square }}
                  >
                    <Settings className="text-slate-700" style={{ width: t.size, height: t.size }} strokeWidth={1.5} />
                  </div>
                  <span className="text-xs font-semibold text-slate-700">{t.size}px</span>
                  <span className="text-[10px] text-muted-foreground">Box {t.square}px</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div>
          <h3 className="font-bold text-base">Semantic Color treatments</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Icon color allocations driving interactive statuses.</p>
          <div className="mt-4 rounded-xl border bg-card p-2 divide-y">
            {SEMANTIC_COLORS.map((s) => (
              <div key={s.label} className="flex items-center justify-between gap-3 px-3 py-3">
                <div className="flex items-center gap-3 min-w-0">
                  <Settings className="h-5 w-5 shrink-0" style={{ color: s.color }} strokeWidth={1.5} />
                  <span className="text-sm font-medium">{s.label}</span>
                </div>
                <span className="text-xs text-muted-foreground text-right">{s.purpose}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h3 className="font-bold text-base">Icon Grid &amp; Keylines</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Constructive geometry grid ensuring visual weight matches.</p>
          <div className="mt-4 rounded-xl border bg-card p-5 flex items-center gap-5">
            <div className="relative flex h-20 w-20 shrink-0 items-center justify-center rounded-lg border border-dashed border-[#CBD5E1] bg-[#F8FAFC]">
              <svg className="absolute inset-0 h-full w-full text-[#3B82F6]" aria-hidden="true">
                <defs>
                  <pattern id="keyline-grid" width="8" height="8" patternUnits="userSpaceOnUse">
                    <circle cx="1" cy="1" r="0.8" fill="currentColor" />
                  </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#keyline-grid)" />
              </svg>
              <div className="absolute h-10 w-10 rounded-full border border-dashed border-[#3B82F6]" />
              <Check className="relative h-6 w-6 text-[#3B82F6]" strokeWidth={2} />
            </div>
            <div className="min-w-0">
              <p className="font-bold text-sm">24px Base Keyline System</p>
              <p className="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                Create all system graphics inside a 24×24px workspace container featuring a surrounding 2px safe-zone margin. Respect internal keylines bounding box standards for round or sharp indicators.
              </p>
            </div>
          </div>
        </div>

        <div>
          <h3 className="font-bold text-base">Interactive Touch targets</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Ensuring proper dimensions matching compliance guidelines.</p>
          <div className="mt-4 rounded-xl border bg-card p-5 flex items-center gap-5">
            <div className="relative flex h-20 w-20 shrink-0 items-center justify-center rounded-lg border border-solid border-[#C7D2FE] bg-[#EEF2F6]">
              <div className="absolute h-5 w-5 rounded-sm border border-dashed border-[#3B82F6] flex items-center justify-center">
                <CloseIcon className="h-3 w-3 text-[#4F46E5]" strokeWidth={1.5} />
              </div>
            </div>
            <div className="min-w-0">
              <p className="font-bold text-sm">Min Touch Target: 44×44px</p>
              <p className="mt-1.5 text-xs text-muted-foreground leading-relaxed">
                Even if the graphic footprint remains compact (e.g., a 20px close element), assure the interactive bounding-box container respects the minimum 44px bounds requested by WCAG.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

const ELEVATION_LEVELS = [
  { level: "LEVEL 0", usage: "Flat layout panels. Flat forms.", shadow: "none" },
  { level: "LEVEL 1", usage: "Basic information cards.", shadow: "0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px 0 rgba(0, 0, 0, 0.03)" },
  { level: "LEVEL 2", usage: "Dropdown lists, navigation flyouts.", shadow: "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)" },
  { level: "LEVEL 3", usage: "Modal dialog frames, system alerts.", shadow: "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)" },
]

const BORDER_STYLES = [
  { label: "Solid 1px", className: "border border-[#CBD5E1]" },
  { label: "Solid 2px", className: "border-2 border-[#334155]" },
  { label: "Dashed Border", className: "border-2 border-dashed border-[#94A3B8]" },
  { label: "Dotted Border", className: "border-2 border-dotted border-[#94A3B8]" },
]

