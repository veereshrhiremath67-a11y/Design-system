        <div className="grid grid-cols-4 sm:grid-cols-8 gap-2">
          {(dv.paletteColors || dv.categoricalPalette || []).map((c: any, i: number) => {
            const hex = typeof c === "string" ? c : c.hex
            const name = typeof c === "string" ? "" : c.name
            return (
              <div key={i} className="space-y-1 text-center">
                <div className="h-10 rounded-lg border" style={{ backgroundColor: hex }} />
                {name && <p className="text-[10px] text-muted-foreground truncate">{name}</p>}
              </div>
            )
          })}
        </div>
      </div>

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">Graph Specs</p>
        <div className="space-y-2">
          {Object.entries(dv.graphSpecs || {}).map(([key, val]) => (
            <div key={key} className="p-3 rounded-xl border">
              <p className="text-sm font-medium capitalize">{key}</p>
              <p className="text-xs text-muted-foreground mt-1">{val as string}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">Interactive Specs</p>
        <div className="space-y-2">
          {Object.entries(dv.interactiveGraphSpecs || {}).map(([key, val]) => (
            <div key={key} className="flex items-start justify-between p-3 rounded-xl border">
              <span className="text-sm font-medium capitalize">{key}</span>
              <span className="text-xs text-muted-foreground text-right max-w-[65%]">{val as string}</span>
            </div>
          ))}
