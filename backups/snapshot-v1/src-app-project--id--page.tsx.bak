      {dv.compliance && (
        <div className="p-3 rounded-xl bg-green-50/50 border border-green-200">
          <p className="text-xs text-green-800">{dv.compliance}</p>
        </div>
      )}
    </div>
  )
}

function inferPreviewControl(name: string): "button" | "badge" | "input" | "toggle" | "checkbox" | "radio" | "card" | "tooltip" | "tile" {
  const n = name.toLowerCase()
  if (n.includes("checkbox")) return "checkbox"
  if (n.includes("radio") || n.includes("radion")) return "radio"
  if (n.includes("button") || n.includes("action") || n.includes("cta")) return "button"
  if (n.includes("badge") || n.includes("pill") || n.includes("tag") || n.includes("chip") || n.includes("label")) return "badge"
  if (n.includes("tooltip") || n.includes("popover")) return "tooltip"
  if (n.includes("card") || n.includes("panel") || n.includes("surface")) return "card"
  if (n.includes("input") || n.includes("field") || n.includes("select") || n.includes("text") || n.includes("search")) return "input"
  if (n.includes("toggle") || n.includes("switch")) return "toggle"
  return "tile"
}

const SIZE_SCALE: Record<string, string> = {
  sm: "sm", small: "sm", md: "md", medium: "md", default: "md", lg: "lg", large: "lg", xl: "xl",
}

function ComponentPreview({ name, tone }: { name: string; tone: string }) {
  const kind = inferPreviewControl(name)
  const size = SIZE_SCALE[name.toLowerCase()] || "md"
  const compact = size === "sm"
  const large = size === "lg"

  const checkBox = (
    <span className={`inline-flex shrink-0 items-center justify-center rounded border-2 ${compact ? "h-3.5 w-3.5" : large ? "h-5 w-5" : "h-4 w-4"} ${tone.split(" ")[0] === "bg-slate-800" ? "border-slate-800 bg-slate-800" : "border-slate-400 bg-white"}`}>
      <span className="text-white">✓</span>
    </span>
  )

  const radioBox = (
    <span className={`inline-flex shrink-0 items-center justify-center rounded-full border-2 ${compact ? "h-3.5 w-3.5" : large ? "h-5 w-5" : "h-4 w-4"} ${tone.split(" ")[0] === "bg-slate-800" ? "border-slate-800" : "border-slate-400 bg-white"}`}>
      <span className={`rounded-full bg-slate-700 ${compact ? "h-1.5 w-1.5" : large ? "h-2.5 w-2.5" : "h-2 w-2"}`} />
    </span>
  )

  if (kind === "checkbox") {
    return (
      <span className="inline-flex items-center gap-2">
        {checkBox}
        <span className={`font-medium text-slate-700 ${compact ? "text-[11px]" : large ? "text-sm" : "text-xs"}`}>Checkbox</span>
      </span>
    )
  }
  if (kind === "radio") {
    return (
      <span className="inline-flex items-center gap-2">
        {radioBox}
        <span className={`font-medium text-slate-700 ${compact ? "text-[11px]" : large ? "text-sm" : "text-xs"}`}>Radio</span>
      </span>
    )
  }
  if (kind === "button") {
    return (
      <span className={`inline-flex shrink-0 items-center justify-center rounded-md bg-slate-800 font-medium text-white ${compact ? "h-8 px-3 text-xs" : large ? "h-12 px-6 text-base" : "h-10 px-4 text-sm"}`}>
        {name.replace(/ button$/i, "") || "Button"}
      </span>
    )
  }
  if (kind === "badge") {
    return (
      <span className={`inline-flex shrink-0 items-center rounded-full font-medium ${compact ? "px-2.5 py-0.5 text-[11px]" : large ? "px-4 py-1.5 text-sm" : "px-3 py-1 text-xs"} ${tone}`}>
        {name}
      </span>
    )
  }
  if (kind === "tooltip") {
    return (
      <span className="relative inline-flex items-center gap-2 shrink-0">
        <span className={`inline-flex items-center rounded-md border border-slate-300 bg-white text-slate-500 ${compact ? "h-7 px-2.5 text-[11px]" : large ? "h-11 px-5 text-sm" : "h-9 px-3.5 text-xs"}`}>
          {name}
        </span>
        <span className={`absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-slate-800 px-2.5 py-1 ${compact ? "text-[10px]" : "text-[11px]"} font-medium text-white`}>
          Info tooltip
        </span>
      </span>
    )
  }
  if (kind === "card") {
    return (
      <span className={`inline-flex shrink-0 flex-col justify-center rounded-lg border border-slate-200 bg-white ${compact ? "h-9 px-3" : large ? "h-14 px-5" : "h-11 px-4"} w-24`}>
        <span className={`block truncate font-semibold text-slate-700 ${compact ? "text-[11px]" : "text-xs"}`}>{name}</span>
        <span className="mt-0.5 block truncate text-[10px] text-slate-400">Card body</span>
      </span>
    )
  }
  if (kind === "input") {
    return (
      <span className={`inline-flex shrink-0 items-center rounded-md border border-slate-300 bg-white text-slate-400 ${compact ? "h-8 px-3 text-xs" : large ? "h-12 px-5 text-base" : "h-10 px-3.5 text-sm"}`}>
        {name}…
      </span>
    )
  }
  if (kind === "toggle") {
    return (
      <span className={`inline-flex shrink-0 items-center rounded-full ${tone} ${compact ? "h-5 w-9" : large ? "h-8 w-14" : "h-6 w-11"}`}>
        <span className={`rounded-full bg-white shadow ${compact ? "ml-1 h-3.5 w-3.5" : large ? "ml-1 h-6 w-6" : "ml-1 h-4 w-4"}`} />
      </span>
    )
  }
  return <span className="inline-flex shrink-0 items-center rounded-lg border border-slate-200 bg-[#F8FAFC] px-3 h-10 text-xs text-slate-500">{name}</span>
}

function stateTone(name: string): { bg: string; dot: string; text: string } {
  const n = (name || "").toLowerCase()
  if (n.includes("disabled") || n.includes("quiet")) return { bg: "bg-slate-100", dot: "bg-slate-400", text: "text-slate-500" }
  if (n.includes("error") || n.includes("danger") || n.includes("destructive") || n.includes("failed")) return { bg: "bg-red-50 ring-red-200", dot: "bg-red-500", text: "text-red-700" }
  if (n.includes("warning") || n.includes("caution")) return { bg: "bg-amber-50 ring-amber-200", dot: "bg-amber-500", text: "text-amber-700" }
  if (n.includes("success") || n.includes("active") || n.includes("pressed")) return { bg: "bg-emerald-50 ring-emerald-200", dot: "bg-emerald-500", text: "text-emerald-700" }
  if (n.includes("hover") || n.includes("focus") || n.includes("info")) return { bg: "bg-blue-50 ring-blue-200", dot: "bg-blue-500", text: "text-blue-700" }
  return { bg: "bg-slate-50 ring-slate-200", dot: "bg-slate-400", text: "text-slate-600" }
}

function ComponentsSection({ d }: { d: DesignData }) {
  const components = d.components || []
  const variantsTotal = components.reduce((sum: number, c: any) => sum + (c.variants?.length || 0), 0)
  const statesTotal = components.reduce((sum: number, c: any) => sum + (c.states?.length || 0), 0)

  return (
    <div className="space-y-5">
      <SectionHeader title="Component Library" description="Live building blocks — every control is rendered from live tokens, not mockups." icon={Layers} />

      <div className="flex flex-wrap gap-2">
        <span className="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600">
          {components.length} components
        </span>
        <span className="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600">
          {variantsTotal} variants
        </span>
        <span className="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600">
          {statesTotal} states
        </span>
      </div>

      <div className="space-y-5">
        {components.map((comp: any, ci: number) => {
          return (
            <div key={comp.name} className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div className="flex items-stretch gap-4 p-5">
                <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-xs font-bold text-white">
                  {String(ci + 1).padStart(2, "0")}
                </div>
                <div className="min-w-0 flex-1">
                  <div className="flex items-center justify-between gap-3">
                    <h4 className="text-base font-bold text-slate-900">{comp.name}</h4>
                    <Badge variant="secondary" className="text-[10px] shrink-0 whitespace-nowrap">{comp.variants?.length || 0} variants</Badge>
                  </div>
                  {comp.description && <p className="text-xs text-slate-600 mt-1 leading-relaxed">{comp.description}</p>}
                </div>
              </div>

              {comp.anatomy && comp.anatomy.length > 0 && (
                <div className="flex flex-wrap items-center gap-x-3 gap-y-1.5 border-t border-slate-100 px-5 py-3 bg-slate-50/60">
                  {comp.anatomy.map((a: string, ai: number) => (
                    <span key={a} className="inline-flex items-center gap-1.5 text-xs text-slate-600">
                      {ai > 0 && <span className="text-slate-300">/</span>}
                      <span className="rounded bg-white px-1.5 py-0.5 ring-1 ring-slate-200">{a}</span>
                    </span>
                  ))}
                </div>
              )}

              {(comp.variants?.length > 0 || comp.sizes?.length > 0 || comp.states?.length > 0) && (
                <div className="border-t border-slate-100 bg-[#F8FAFC] p-5">
                  {comp.variants?.length > 0 && (
                    <div className="mb-6">
                      <p className="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-3">Variants</p>
                      <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
                        {comp.variants.map((v: any) => (
                          <div key={v.name} className="flex items-stretch gap-3 rounded-xl border border-slate-200 bg-white p-3">
                            <div className="flex w-32 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-slate-100 bg-[#F8FAFC] px-2 py-3">
                              <ComponentPreview name={v.name} tone="bg-slate-800 text-white" />
                            </div>
                            <div className="flex min-w-0 flex-1 flex-col justify-center">
                              <p className="text-sm font-medium text-slate-800 truncate">{v.name}</p>
                              {v.description && <p className="text-xs text-slate-500 mt-0.5 leading-relaxed line-clamp-2">{v.description}</p>}
                            </div>
                          </div>
                        ))}
                      </div>
                      {comp.variants[0]?.usage && (
                        <p className="mt-3 text-xs text-slate-500"><span className="font-semibold text-slate-700">Usage:</span> {comp.variants[0].usage}</p>
                      )}
                    </div>
                  )}

                  {comp.sizes?.length > 0 && (
                    <div className="mb-6">
                      <p className="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-3">Sizes</p>
                      <div className="flex flex-wrap items-end gap-6 rounded-xl border border-slate-200 bg-white p-4">
                        {comp.sizes.map((s: any) => (
                          <div key={s.name} className="flex flex-col items-center gap-2 min-w-0">
                            <div className="flex h-20 w-28 items-end justify-center rounded-lg border border-dashed border-slate-200 bg-[#F8FAFC] px-2 pb-3">
                              <ComponentPreview name={s.name || "sm"} tone="bg-slate-800 text-white" />
                            </div>
                            <p className="text-xs font-medium text-slate-700 capitalize">{s.name}</p>
                            {Object.entries(s).filter(([k]) => k !== "name").length > 0 && (
                              <p className="text-[10px] text-slate-500 text-center">
                                {Object.entries(s).filter(([k]) => k !== "name").map(([k, v]) => `${k} ${v}`).join(" · ")}
                              </p>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {comp.states?.length > 0 && (
                    <div>
                      <p className="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-3">States</p>
                      <div className="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3">
                        {comp.states.map((s: any) => {
                          const tone = stateTone(s.name || "")
                          return (
                            <div key={s.name} className="rounded-xl border border-slate-200 bg-white p-3">
                              <div className="flex h-12 items-center justify-center">
                                <span className={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium ring-1 ${tone.bg} ${tone.text}`}>
                                  <span className={`h-2 w-2 rounded-full ${tone.dot}`} />
                                  {s.name}
                                </span>
                              </div>
                              {s.description && <p className="text-[11px] text-slate-500 mt-2 leading-relaxed">{s.description}</p>}
                            </div>
                          )
                        })}
                      </div>
                    </div>
                  )}
                </div>
              )}

              {comp.accessibility && (
                <div className="flex items-start gap-2.5 border-t border-slate-100 bg-slate-50/60 px-5 py-3">
                  <Accessibility className="h-4 w-4 text-slate-500 shrink-0 mt-0.5" />
                  <p className="text-xs text-slate-600 leading-relaxed">{comp.accessibility}</p>
                </div>
              )}
            </div>
          )
        })}
      </div>
    </div>
  )
}

function PatternsSection({ d }: { d: DesignData }) {
  return (
    <div className="space-y-4">
      <SectionHeader title="Design Patterns" description="Common page layouts and templates" icon={Layout} />
      <div className="space-y-4">
        {(d.patterns || []).map((pattern: any) => (
          <Card key={pattern.name}>
            <CardHeader className="pb-3">
              <div className="flex items-start justify-between">
                <CardTitle className="text-base">{pattern.name}</CardTitle>
                <Badge variant="outline" className="text-[10px]">{pattern.sections?.length || 0} sections</Badge>
              </div>
              {pattern.description && <p className="text-xs text-muted-foreground mt-1">{pattern.description}</p>}
            </CardHeader>
            <CardContent className="space-y-4">
              {pattern.sections && (
                <div>
                  <p className="text-[10px] text-muted-foreground font-semibold uppercase tracking-wider mb-2">Sections</p>
                  <div className="flex flex-wrap gap-1.5">
                    {pattern.sections.map((s: string) => (
                      <Badge key={s} variant="secondary" className="text-[10px]">{s}</Badge>
                    ))}
                  </div>
                </div>
              )}

              {pattern.variants && pattern.variants.length > 0 && (
                <div>
                  <p className="text-[10px] text-muted-foreground font-semibold uppercase tracking-wider mb-2">Variants</p>
                  <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
                    {pattern.variants.map((v: any) => (
                      <div key={v.name} className="p-3 rounded-xl border">
                        <p className="text-sm font-medium">{v.name}</p>
                        <p className="text-xs text-muted-foreground mt-0.5">{v.description}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {pattern.states && pattern.states.length > 0 && (
                <div>
                  <p className="text-[10px] text-muted-foreground font-semibold uppercase tracking-wider mb-2">States</p>
                  <div className="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-6 gap-3">
                    {pattern.states.map((s: any) => (
                      <div key={s.name} className="p-3 rounded-xl border">
                        <p className="text-sm font-medium">{s.name}</p>
                        <p className="text-xs text-muted-foreground mt-0.5">{s.description}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  )
}

function MotionSection({ d }: { d: DesignData }) {
  return (
    <div className="space-y-4">
      <SectionHeader title="Motion" description="Animation durations, easing curves, and interaction guidelines" icon={Monitor} />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">Durations</p>
        <div className="grid grid-cols-5 gap-3">
          {Object.entries(d.motion?.duration || {}).map(([key, val]) => (
            <div key={key} className="p-4 rounded-xl border text-center">
              <p className="text-sm font-medium capitalize">{key}</p>
              <p className="text-lg font-bold text-primary mt-1">{val as string}</p>
            </div>
          ))}
        </div>
      </div>

      <Separator />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">Easing Curves</p>
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {Object.entries(d.motion?.easing || {}).map(([key, val]) => (
            <div key={key} className="p-4 rounded-xl border">
              <p className="text-sm font-medium capitalize">{key}</p>
              <p className="text-xs font-mono text-muted-foreground mt-1">{val as string}</p>
            </div>
          ))}
        </div>
      </div>

      <Separator />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-4">Animation Guidelines</p>
        <div className="space-y-3">
          {(d.motion?.guidelines || []).map((g: any) => (
            <Card key={g.type}>
              <CardContent className="pt-4 space-y-2">
                <div className="flex items-center justify-between">
                  <h4 className="font-medium text-sm">{g.type}</h4>
                  <Badge variant="secondary" className="text-[10px]">{g.duration}</Badge>
                </div>
                <p className="text-sm text-muted-foreground leading-relaxed">{g.description}</p>
                <p className="text-xs text-muted-foreground font-mono">Easing: {g.easing}</p>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>
    </div>
  )
}

function AccessibilitySection({ d }: { d: DesignData }) {
  return (
    <div className="space-y-4">
      <SectionHeader title="Accessibility" description="WCAG compliance, contrast reports, and best practices" icon={Accessibility} />

      <div className="grid grid-cols-3 gap-3">
        <div className="p-4 rounded-xl border text-center">
          <p className="text-2xl font-bold text-primary">{d.accessibility?.level || "AA"}</p>
          <p className="text-xs text-muted-foreground mt-1">Compliance</p>
        </div>
        <div className="p-4 rounded-xl border text-center">
          <p className="text-2xl font-bold text-primary">44x44px</p>
          <p className="text-xs text-muted-foreground mt-1">Touch Targets</p>
        </div>
        <div className="p-4 rounded-xl border text-center">
          <p className="text-2xl font-bold text-primary">4.5:1</p>
          <p className="text-xs text-muted-foreground mt-1">Min Contrast</p>
        </div>
      </div>

      <Separator />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">WCAG Principles</p>
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {(d.accessibility?.principles || []).map((p: string) => {
            const [title, ...desc] = p.split(" — ")
            return (
              <div key={p} className="p-4 rounded-xl border">
                <p className="font-medium text-sm">{title}</p>
                <p className="text-xs text-muted-foreground mt-1 leading-relaxed">{desc.join(" — ")}</p>
              </div>
            )
          })}
        </div>
      </div>

      <Separator />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">Contrast Report</p>
        <div className="space-y-2">
          {Object.entries(d.accessibility?.contrastReport || {}).map(([key, val]) => (
            <div key={key} className="flex items-center justify-between p-3 rounded-xl border">
              <div className="flex items-center gap-2.5">
                <Check className="h-4 w-4 text-green-500" />
                <span className="text-sm">{key}</span>
              </div>
              <Badge variant="outline" className="text-xs">{val as string}</Badge>
            </div>
          ))}
        </div>
      </div>

      <Separator />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">Best Practices</p>
        <div className="space-y-2">
          {(d.accessibility?.bestPractices || []).map((p: string) => (
            <DoCard key={p}>{p}</DoCard>
          ))}
        </div>
      </div>

      <Separator />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">ARIA Suggestions</p>
        <div className="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3">
          {(d.accessibility?.ariaSuggestions || []).map((a: string) => (
            <div key={a} className="p-3 rounded-xl border">
              <code className="text-xs font-mono text-primary">{a}</code>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

function DocsSection({ d }: { d: DesignData }) {
  return (
    <div className="space-y-4">
      <SectionHeader title="Documentation" description="Getting started guide, usage guidelines, and developer notes" icon={FileText} />

      <div className="p-4 rounded-xl border">
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-2">Overview</p>
        <p className="text-sm text-muted-foreground leading-relaxed">{d.documentation?.overview}</p>
      </div>

      <Separator />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">Getting Started</p>
        <div className="space-y-2">
          {(d.documentation?.gettingStarted || []).map((step: string) => (
            <div key={step} className="flex items-start gap-3 p-3 rounded-xl border">
              <div className="h-6 w-6 rounded-full bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
                <span className="text-xs font-bold text-primary">{(d.documentation?.gettingStarted?.indexOf(step) || 0) + 1}</span>
              </div>
              <p className="text-sm">{step}</p>
            </div>
          ))}
        </div>
      </div>

      <Separator />

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3 text-green-600">Do&apos;s</p>
          <div className="space-y-2">
            {(d.documentation?.dos || []).map((item: string) => (
              <DoCard key={item}>{item}</DoCard>
            ))}
          </div>
        </div>
        <div>
          <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3 text-red-600">Don&apos;ts</p>
          <div className="space-y-2">
            {(d.documentation?.donts || []).map((item: string) => (
              <DontCard key={item}>{item}</DontCard>
            ))}
          </div>
        </div>
      </div>

      <Separator />

      <div>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold mb-3">Developer Notes</p>
        <div className="space-y-2">
          {(d.documentation?.developerNotes || []).map((note: string) => (
            <div key={note} className="flex items-start gap-2.5 p-3 rounded-xl border">
              <div className="h-1.5 w-1.5 rounded-full bg-primary mt-2 shrink-0" />
              <p className="text-sm">{note}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}
