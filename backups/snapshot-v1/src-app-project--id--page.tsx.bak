"use client"

import { use, useEffect, useState } from "react"
import { useSession } from "next-auth/react"
import { redirect } from "next/navigation"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { Separator } from "@/components/ui/separator"
import { ScrollArea } from "@/components/ui/scroll-area"
import {
  Palette, ArrowLeft, Eye, Edit3, Loader2, Check, X, Accessibility,
  Sparkles, Type, Layout, Layers, Grid3X3, Monitor, FileText, ChevronRight,
  Image as ImageIcon, Boxes, BarChart3, Repeat2, Maximize, Info, Zap, Star,
  Hexagon, ScrollText, Search, Settings, User, Bell, Heart, Menu, Plus, Home, ArrowUp,
  X as CloseIcon, type LucideIcon
} from "lucide-react"
import Link from "next/link"
import { ExportDropdown } from "@/components/export-dropdown"
import { ThemeToggle } from "@/components/theme-toggle"
import { toast } from "sonner"

interface DesignData {
  systemName?: string
  version?: string
  lastUpdated?: string
  overview?: any
  colorSystemDoc?: any
  typographyDoc?: any
  systemArchitecture?: any
  brandFoundation: any
  designPrinciples: string[]
  tokens: any
  colorSystem: any
  typography: any
  spacingLayout: any
  components: any[]
  patterns: any[]
  accessibility: any
  motion: any
  dataViz: any
  documentation: any
}

const NAV_ITEMS = [
  { id: "overview", label: "Overview & Design Principles", icon: ScrollText },
  { id: "appearance", label: "Appearance", icon: Monitor },
  { id: "brand", label: "Brand", icon: Sparkles },
  { id: "colors", label: "Color System", icon: Palette },
  { id: "typography", label: "Typography & Type Scale", icon: Type },
  { id: "spacing", label: "Spacing", icon: Grid3X3 },
  { id: "grid", label: "Grid & Layout", icon: Layout },
  { id: "iconography", label: "Iconography", icon: ImageIcon },
  { id: "elevation", label: "Elevation & Surfaces", icon: Boxes },
  { id: "components", label: "Components", icon: Layers },
  { id: "patterns", label: "Patterns", icon: Layout },
  { id: "motion", label: "Motion", icon: Monitor },
  { id: "dataviz", label: "Data Viz", icon: BarChart3 },
  { id: "accessibility", label: "Accessibility", icon: Accessibility },
  { id: "docs", label: "Documentation", icon: FileText },
]

export default function ProjectPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = use(params)
  const { data: session, status } = useSession()
  const [project, setProject] = useState<any>(null)
  const [loading, setLoading] = useState(true)
  const [activeSection, setActiveSection] = useState("overview")

  useEffect(() => {
    if (status === "authenticated") {
      fetch(`/api/projects/${id}`)
        .then((res) => res.json())
        .then(setProject)
        .catch(() => toast.error("Failed to load project"))
        .finally(() => setLoading(false))
    }
  }, [status, id])

  if (status === "loading" || loading) {
    return (
      <div className="flex-1 flex items-center justify-center">
        <Loader2 className="h-8 w-8 animate-spin text-muted-foreground" />
      </div>
    )
  }

  if (status === "unauthenticated") redirect("/login")
  if (!project) return <div className="flex-1 flex items-center justify-center text-muted-foreground">Project not found</div>

  const designDataRaw = typeof project.designData === "string" ? JSON.parse(project.designData) : project.designData
  const d: DesignData = designDataRaw
  const primary = d.tokens?.colors?.primary || "#6366f1"

  return (
    <div className="h-screen overflow-hidden flex flex-col">
      <header className="shrink-0 border-b bg-background z-10">
        <div className="flex items-center justify-between h-16 px-6">
          <div className="flex items-center gap-3 min-w-0">
            <Link href="/dashboard">
              <Button variant="ghost" size="icon">
                <ArrowLeft className="h-5 w-5" />
              </Button>
            </Link>
            <div className="h-8 w-8 rounded-lg flex items-center justify-center" style={{ backgroundColor: primary }}>
              <Palette className="h-4 w-4 text-white" />
            </div>
            <div>
              <span className="font-bold text-base truncate block max-w-[200px]">{project.name}</span>
              <span className="text-xs text-muted-foreground">{d.brandFoundation?.brandName || project.brandName}</span>
            </div>
            <Badge variant="secondary" className="text-xs">{project.status}</Badge>
          </div>
          <div className="flex items-center gap-2">
            <Link href={`/preview?id=${id}`}>
              <Button variant="outline" size="sm">
                <Eye className="mr-1.5 h-3.5 w-3.5" />
                Preview
              </Button>
            </Link>
            <Link href={`/create?edit=${id}`}>
              <Button variant="outline" size="sm">
                <Edit3 className="mr-1.5 h-3.5 w-3.5" />
                Edit
              </Button>
            </Link>
            <ThemeToggle />
            <ExportDropdown projectId={id} />
          </div>
        </div>
      </header>

      <div className="flex-1 flex overflow-hidden">
        <aside className="w-56 border-r bg-muted/20 hidden md:flex flex-col shrink-0">
          <ScrollArea className="flex-1 py-3 px-2">
            <nav className="space-y-0.5">
              {NAV_ITEMS.map(({ id: sectionId, label, icon: Icon }) => (
                <button
                  key={sectionId}
                  onClick={() => setActiveSection(sectionId)}
                  className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-md text-sm text-left transition-colors ${
                    activeSection === sectionId
                      ? "bg-primary/10 text-primary font-medium"
                      : "text-muted-foreground hover:text-foreground hover:bg-muted"
                  }`}
                >
                  <Icon className="h-4 w-4 shrink-0" />
                  {label}
                  {activeSection === sectionId && (
                    <ChevronRight className="h-3.5 w-3.5 ml-auto" />
                  )}
                </button>
              ))}
            </nav>
          </ScrollArea>
        </aside>

        <main className="flex-1 overflow-y-auto">
          <div className="py-4 px-4 sm:px-6 lg:px-8 space-y-4">
            {activeSection === "overview" && <OverviewSection d={d} />}
            {activeSection === "appearance" && (
              <AppearanceSection d={d} primary={primary} />
            )}
            {activeSection === "brand" && <BrandSection d={d} />}
            {activeSection === "colors" && <ColorSystemSection d={d} />}
            {activeSection === "typography" && <TypographySection d={d} />}
            {activeSection === "spacing" && <SpacingSection d={d} />}
            {activeSection === "grid" && <GridSection d={d} />}
            {activeSection === "iconography" && <IconographySection d={d} />}
            {activeSection === "elevation" && <ElevationSection d={d} />}
            {activeSection === "components" && <ComponentsSection d={d} />}
            {activeSection === "patterns" && <PatternsSection d={d} />}
            {activeSection === "motion" && <MotionSection d={d} />}
            {activeSection === "dataviz" && <DataVizSection d={d} />}
            {activeSection === "accessibility" && <AccessibilitySection d={d} />}
            {activeSection === "docs" && <DocsSection d={d} />}
          </div>
        </main>
      </div>
    </div>
  )
}

function SectionHeader({ title, description, icon: Icon }: { title: string; description?: string; icon: any }) {
  return (
    <div className="space-y-1 pb-1">
      <div className="flex items-center gap-2.5">
        <div className="h-7 w-7 rounded-lg bg-primary/10 flex items-center justify-center">
          <Icon className="h-4 w-4 text-primary" />
        </div>
        <h2 className="text-xl font-bold">{title}</h2>
      </div>
      {description && <p className="text-sm text-muted-foreground ml-9">{description}</p>}
      <Separator className="mt-3" />
    </div>
  )
}

function InfoCard({ label, value }: { label: string; value: string }) {
  return (
    <div className="p-4 rounded-xl border bg-card">
      <p className="text-xs text-muted-foreground uppercase tracking-wider mb-1">{label}</p>
      <p className="font-medium text-sm leading-relaxed">{value}</p>
    </div>
  )
}

function DoCard({ children }: { children: React.ReactNode }) {
  return (
    <div className="flex items-start gap-2.5 p-3 rounded-xl bg-green-50/50 border border-green-200">
      <Check className="h-4 w-4 text-green-500 shrink-0 mt-0.5" />
      <span className="text-sm text-green-800">{children}</span>
    </div>
  )
}

function DontCard({ children }: { children: React.ReactNode }) {
  return (
    <div className="flex items-start gap-2.5 p-3 rounded-xl bg-red-50/50 border border-red-200">
      <X className="h-4 w-4 text-red-500 shrink-0 mt-0.5" />
      <span className="text-sm text-red-800">{children}</span>
    </div>
  )
}

function AppearanceSection({ d, primary }: { d: DesignData; primary: string }) {
  const radius = d.tokens?.radius || "8px"
  const shadows = d.tokens?.shadows || {}
  const fontFamily = d.tokens?.typography?.fontFamily || "Inter, sans-serif"

  return (
    <div className="space-y-4">
      <SectionHeader title="Appearance" description="Visual preview of your design system applied to common UI elements" icon={Monitor} />

      <div className="p-4 rounded-xl border space-y-4" style={{ fontFamily }}>
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="h-8 w-8 rounded-lg flex items-center justify-center" style={{ backgroundColor: primary }}>
              <Palette className="h-4 w-4 text-white" />
            </div>
            <span className="font-bold">Brand</span>
          </div>
          <div className="flex gap-2">
            <div className="h-6 w-12 rounded-full" style={{ backgroundColor: d.tokens?.colors?.primaryLight, borderRadius: radius }} />
            <div className="h-6 w-12 rounded-full" style={{ backgroundColor: d.tokens?.colors?.secondary, borderRadius: radius }} />
            <div className="h-6 w-12 rounded-full" style={{ backgroundColor: d.tokens?.colors?.accent, borderRadius: radius }} />
          </div>
        </div>
      </div>

      <div className="p-4 rounded-xl border space-y-3" style={{ fontFamily }}>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold">Typography Preview</p>
        <p className="text-3xl font-bold leading-tight" style={{ fontFamily: d.typography?.headingFont }}>
          Heading Level 1
        </p>
        <p className="text-2xl font-semibold leading-tight" style={{ fontFamily: d.typography?.headingFont }}>
          Heading Level 2
        </p>
        <p className="text-lg font-medium leading-snug" style={{ fontFamily: d.typography?.headingFont }}>
          Heading Level 3
        </p>
        <p className="text-base leading-relaxed">
          Body text. The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs.
          This is how your paragraph text will look across your entire product.
        </p>
        <p className="text-sm leading-relaxed text-muted-foreground">
          Secondary body text for less prominent content. Perfect for descriptions and supporting information.
        </p>
        <p className="text-xs text-muted-foreground">Caption and metadata text for small print and labels.</p>
      </div>

      <div className="p-4 rounded-xl border space-y-4" style={{ fontFamily }}>
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold">Components Preview</p>

        <div className="flex flex-wrap gap-3">
          <button className="px-5 py-2.5 text-sm font-medium text-white rounded-lg transition-all hover:opacity-90" style={{ backgroundColor: primary, borderRadius: radius }}>
            Primary Button
          </button>
          <button className="px-5 py-2.5 text-sm font-medium rounded-lg border transition-all hover:bg-muted" style={{ borderRadius: radius, borderColor: d.tokens?.colors?.neutral?.[200] || "#e5e5e5" }}>
            Secondary Button
          </button>
          <button className="px-5 py-2.5 text-sm font-medium rounded-lg border-2 transition-all hover:opacity-80" style={{ borderRadius: radius, borderColor: primary, color: primary }}>
            Outline Button
          </button>
        </div>

        <div className="flex flex-wrap gap-3">
          <div className="px-3 py-1.5 text-xs font-medium rounded-full" style={{ backgroundColor: d.tokens?.colors?.primaryLight, color: primary }}>
            Badge
          </div>
          <div className="px-3 py-1.5 text-xs font-medium rounded-full bg-green-100 text-green-700">
            Success
          </div>
          <div className="px-3 py-1.5 text-xs font-medium rounded-full bg-red-100 text-red-700">
            Error
          </div>
          <div className="px-3 py-1.5 text-xs font-medium rounded-full bg-yellow-100 text-yellow-700">
            Warning
          </div>
        </div>

        <div className="p-4 rounded-xl border space-y-3" style={{ borderRadius: radius }}>
          <p className="font-medium">Sample Card</p>
          <p className="text-sm text-muted-foreground">This is how a card component renders with your design system tokens applied.</p>
          <div className="flex gap-2">
            <button className="px-4 py-1.5 text-xs font-medium text-white rounded-lg" style={{ backgroundColor: primary, borderRadius: radius }}>
              Action
            </button>
            <button className="px-4 py-1.5 text-xs font-medium rounded-lg border" style={{ borderRadius: radius }}>
              Cancel
            </button>
          </div>
        </div>

        <div className="space-y-2">
          <div className="h-10 rounded-lg border px-3 flex items-center text-sm text-muted-foreground" style={{ borderRadius: radius }}>
            Placeholder text...
          </div>
          <div className="h-10 rounded-lg border px-3 flex items-center text-sm gap-2" style={{ borderRadius: radius, borderColor: "#ef4444" }}>
            <span className="text-red-500">!</span>
            <span className="text-muted-foreground">Input with error</span>
          </div>
        </div>
      </div>

      <div className="p-4 rounded-xl border space-y-4">
        <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold">Shadow Samples</p>
        <div className="flex flex-wrap gap-3">                                                              


          {Object.entries(shadows).filter(([k]) => k !== "inner").slice(0, 4).map(([key, val]) => (
            <div key={key} className="w-28 h-20 rounded-xl flex items-center justify-center text-xs font-medium text-muted-foreground" style={{ boxShadow: val as string, borderRadius: radius }}>
              {key}
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

function BrandSection({ d }: { d: DesignData }) {
  return (
    <div className="space-y-4">
      <SectionHeader title="Brand Foundation" description="Core brand identity and usage guidelines" icon={Sparkles} />

      <div className="space-y-4">
        <div className="grid grid-cols-2 gap-3">
          <InfoCard label="Brand Name" value={d.brandFoundation?.brandName || "—"} />
          <InfoCard label="Company" value={d.brandFoundation?.companyName || "—"} />
          <InfoCard label="Industry" value={d.brandFoundation?.industry || "—"} />
          <InfoCard label="Brand Voice" value={d.brandFoundation?.voice || "—"} />
        </div>

        <div className="p-4 rounded-xl border bg-card">
          <p className="text-xs text-muted-foreground uppercase tracking-wider mb-2">Personality</p>
          <div className="flex flex-wrap gap-1.5">
            {(d.brandFoundation?.personality || []).map((p: string) => (
              <Badge key={p}>{p}</Badge>
            ))}
          </div>
        </div>

        <div className="p-4 rounded-xl border bg-card">
          <p className="text-xs text-muted-foreground uppercase tracking-wider mb-2">Keywords</p>
          <div className="flex flex-wrap gap-1.5">
            {(d.brandFoundation?.keywords || []).map((k: string) => (
              <Badge key={k} variant="secondary">{k}</Badge>
            ))}
          </div>
        </div>

        <div className="p-4 rounded-xl border bg-card">
          <p className="text-xs text-muted-foreground uppercase tracking-wider mb-3">Voice Guidelines</p>
          <div className="space-y-2">
            {(d.brandFoundation?.voiceGuidelines || []).map((g: string) => (
              <div key={g} className="flex items-start gap-2.5">
                <div className="h-1.5 w-1.5 rounded-full bg-primary mt-2 shrink-0" />
                <p className="text-sm">{g}</p>
              </div>
            ))}
          </div>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <InfoCard label="Logo Variants" value={(d.brandFoundation?.logoVariations || []).join(", ")} />
          <InfoCard label="Safe Area" value={d.brandFoundation?.logoSafeArea || "—"} />
          <InfoCard label="Min Size" value={d.brandFoundation?.minimumLogoSize || "—"} />
        </div>

        <div className="space-y-2">
          <p className="text-xs text-muted-foreground uppercase tracking-wider font-semibold text-red-600">Incorrect Logo Usage</p>
          {(d.brandFoundation?.incorrectUsage || []).map((u: string) => (
            <DontCard key={u}>{u}</DontCard>
          ))}
        </div>
      </div>
    </div>
  )
}

const DEFAULT_OVERVIEW_PRINCIPLES = [
  { title: "Consistency", icon: "Repeat2", description: "Predictable journeys make systems intuitive. Components must behave uniformly across all application contexts." },
  { title: "Accessibility", icon: "Accessibility", description: "Inclusive design from root variables. AA/AAA compliance as our floor, ensuring usable interfaces for everyone." },
  { title: "Scalability", icon: "Maximize", description: "Build once, deploy everywhere. Tokenized structure accommodates dynamic growth and multi-platform expansion." },
  { title: "Clarity", icon: "Info", description: "Maximize signal, minimize noise. Clean hierarchy, balanced spacing, and purposeful color routing over aesthetics." },
  { title: "Efficiency", icon: "Zap", description: "Optimized developer-to-designer handoff. Standardized slots, variables, and components speed implementation." },
  { title: "Delight", icon: "Star", description: "Subtle animations, rounded details, and premium typographic pairing that turns utility into joy." },
]

const OVERVIEW_ICONS: Record<string, any> = {
  Repeat2,
  Accessibility,
  Maximize,
  Info,
  Zap,
  Star,
  Sparkles,
}

const DEFAULT_ARCH_STEPS = [
  { step: 1, name: "Design Tokens", contents: "Variables: Color, Typography, Spacing", background: "#F8FAFC", color: "#0F172A" },
  { step: 2, name: "Foundation", contents: "Gradients, Icons, Base Grid rules", background: "#E0E7FF", color: "#4F46E5" },
  { step: 3, name: "Components", contents: "Buttons, Inputs, Badges, Toggles", background: "#C7D2FE", color: "#3730A3" },
  { step: 4, name: "Patterns", contents: "Forms, Headers, Tables, Lists", background: "#818CF8", color: "#FFFFFF" },
  { step: 5, name: "Templates", contents: "Standard Screen Scaffolding", background: "#4F46E5", color: "#FFFFFF" },
]

const SERIF = { fontFamily: "'Playfair Display', Georgia, Cambria, 'Times New Roman', serif" }

function OverviewSection({ d }: { d: DesignData }) {
  const overview = d.overview || {}
  const systemName = overview.footerLeft?.split(" — ")[0] || d.systemName || "Design System"
  const version = overview.version || d.version || "v2.0.0"
  const principles = overview.principles?.length ? overview.principles : DEFAULT_OVERVIEW_PRINCIPLES
  const arch = d.systemArchitecture || {}
  const archSteps = overview.architectureSteps?.length
    ? overview.architectureSteps
    : arch.layers?.length
      ? arch.layers.map((l: { name: string; contents: string }, i: number) => ({
          step: i + 1,
          name: l.name,
          contents: l.contents,
          background: DEFAULT_ARCH_STEPS[i]?.background,
          color: DEFAULT_ARCH_STEPS[i]?.color,
        }))
      : DEFAULT_ARCH_STEPS

  return (
    <div className="bg-white p-6 sm:p-8 lg:p-10 text-slate-900 -mx-4 sm:-mx-6 lg:-mx-8">
      <div className="space-y-6">
        <header className="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4">
          <div>
            <p className="text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-[#4F46E5]">
              {overview.category || "01 / FOUNDATION"}
            </p>
            <h1 className="mt-2 text-2xl sm:text-3xl lg:text-4xl font-bold text-[#1E1B4B]" style={SERIF}>
              {overview.title || "Overview & Design Principles"}
            </h1>
          </div>
          <div className="flex items-center gap-3">
            <span className="bg-[#EEF2F6] text-[#4F46E5] text-xs font-bold rounded-full px-3 py-1">{version}</span>
            <span className="text-xs text-[#64748B]">{overview.frame || "Frame 1 of 6"}</span>
          </div>
        </header>

        <section className="rounded-2xl bg-[#1E1B4B] text-white p-7 sm:p-10 flex flex-col lg:flex-row justify-between items-center gap-8">
          <div className="lg:max-w-[70%]">
            <p className="text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-[#93C5FD]">
              {overview.hero?.tag || "ENTERPRISE SYSTEM"}
            </p>
            <h2 className="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight" style={SERIF}>
              {overview.hero?.headline || `${systemName.replace(/ Design System$/, "") || "Apex"} Design System ${version}`}
            </h2>
            <p className="mt-4 text-sm leading-relaxed text-white/80 max-w-2xl">
              {overview.hero?.description || "A unified, scalable visual language powering our entire ecosystem. Engineered for clarity, built for accessibility, and structured to accelerate product engineering from concept to ship."}
            </p>
          </div>
          <div className="w-full lg:w-auto lg:max-w-[30%] flex items-center justify-center">
            <div className="bg-white/5 border border-white/15 rounded-xl p-8 flex items-center justify-center">
              <Hexagon className="h-16 w-16 text-slate-200" />
            </div>
          </div>
        </section>

        <section>
          <div className="pb-4 border-b border-slate-200">
            <h3 className="text-lg font-bold text-[#1E1B4B]">Core Design Principles</h3>
            <p className="mt-1 text-sm text-[#64748B]">The operational guardrails guiding our choices from tokens to complete screen patterns.</p>
          </div>
          <div className="mt-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
            {principles.map((p: { title: string; icon: string; description: string }, i: number) => {
              const Icon = OVERVIEW_ICONS[p.icon] || Sparkles
              return (
                <div key={i} className="bg-white border border-[#E2E8F0] rounded-xl p-6 shadow-sm">
                  <div className="h-10 w-10 rounded-lg bg-[#EEF2F6] text-[#4F46E5] flex items-center justify-center">
                    <Icon className="h-5 w-5" />
                  </div>
                  <h4 className="mt-4 font-bold text-sm text-[#1E1B4B]">{p.title}</h4>
                  <p className="mt-2 text-sm text-[#64748B] leading-relaxed">{p.description}</p>
                </div>
              )
            })}
          </div>
        </section>

        <section>
          <div className="pb-4 border-b border-slate-200">
            <h3 className="text-lg font-bold text-[#1E1B4B]">System Architecture</h3>
            <p className="mt-1 text-sm text-[#64748B]">{arch.description || "How design ingredients combine to build comprehensive experiences."}</p>
          </div>
          <div className="mt-6 flex flex-col lg:flex-row items-stretch gap-2">
            {archSteps.map((s: { step: number; name: string; contents: string; background: string; color: string }, i: number) => (
              <div key={s.step} className="flex flex-col lg:flex-row flex-1 gap-2 items-stretch">
                {i > 0 && (
                  <ChevronRight className="self-center text-[#94A3B8] h-5 w-5 rotate-90 lg:rotate-0 shrink-0" />
                )}
                <div
                  className="flex-1 rounded-xl p-5 border border-black/5"
                  style={{ backgroundColor: s.background, color: s.color }}
                >
                  <p className="text-[11px] font-bold uppercase tracking-wider opacity-70">Step {s.step}</p>
                  <h4 className="mt-1.5 font-bold text-sm">{s.name}</h4>
                  <p className="mt-1.5 text-xs leading-relaxed opacity-80">{s.contents}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section className="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div className="p-6 rounded-xl bg-slate-50 border border-slate-200">
            <h3 className="font-bold text-base text-[#1E1B4B]">When to use the system</h3>
            <p className="mt-2 text-sm text-[#64748B] leading-relaxed">{overview.whenToUse || arch.whenToUse || ""}</p>
          </div>
          <div className="p-6 rounded-xl bg-slate-50 border border-slate-200">
            <h3 className="font-bold text-base text-[#1E1B4B]">Exceptions &amp; Forking</h3>
            <p className="mt-2 text-sm text-[#64748B] leading-relaxed">{overview.exceptions || arch.exceptions || ""}</p>
          </div>
        </section>

        <footer className="flex flex-col sm:flex-row justify-between gap-2 pt-5 border-t border-slate-200 text-xs text-[#64748B]">
          <span>{overview.footerLeft || `${systemName} — Exhaustive Reference Documentation`}</span>
          <span>{overview.footerRight || (d.lastUpdated ? "Last Updated: " + d.lastUpdated.replace(/^Generated\s+/, "") : "")}</span>
        </footer>
      </div>
    </div>
  )
}

const NEUTRAL_ORDER = ["50", "100", "200", "300", "400", "500", "600", "700", "800", "900", "950"]

interface PrimarySwatch { name: string; hex: string; rgb?: string; hsl?: string; description?: string }
interface HighlightSwatch { name: string; hex: string }
interface NeutralBlock { weight: string; hex: string }
interface SemanticRow { name: string; label: string; tint: string; base: string; dark: string }
interface ContrastRow { sample: string; ratio: string }

function ColorSystemSection({ d }: { d: DesignData }) {
  const doc = d.colorSystemDoc || {}
  const colors = d.tokens?.colors || {}
  const cs = d.colorSystem || {}

  const primaryBrand: PrimarySwatch[] = doc.primaryBrand?.length
    ? doc.primaryBrand
    : [
        { name: "Indigo Primary", hex: colors.primary || "#4F46E5", description: "Interactive primary action buttons, active navigation" },
        { name: "Blue Brand", hex: colors.secondary || "#2563EB", description: "Informational states, highlights, interactive accents" },
        { name: "Violet Accent", hex: colors.accent || "#7C3AED", description: "Promo paths, secondary premium features, specialized states" },
      ]

  const secondaryHighlights: HighlightSwatch[] = doc.secondaryHighlights?.length
    ? doc.secondaryHighlights
    : [
        { name: "Teal 600", hex: colors.semantic?.info || "#0D9488" },
        { name: "Emerald 600", hex: colors.semantic?.success || "#059669" },
        { name: "Amber 600", hex: colors.semantic?.warning || "#D97706" },
        { name: "Rose 600", hex: colors.semantic?.error || "#E11D48" },
      ]

  const neutral: NeutralBlock[] = doc.neutral?.length
    ? doc.neutral
    : NEUTRAL_ORDER.map((w) => ({ weight: w, hex: colors.neutral?.[w] })).filter((n) => n.hex)

  const semanticColors: SemanticRow[] = doc.semanticColors?.length
    ? doc.semanticColors
    : [
        { name: "Success State", label: "Positive actions / successful operations", tint: colors.semantic?.successBg || "#DCFCE7", base: colors.semantic?.success || "#10B981", dark: "#064E3B" },
        { name: "Warning State", label: "Requires user caution", tint: colors.semantic?.warningBg || "#FEF3C7", base: colors.semantic?.warning || "#F59E0B", dark: "#78350F" },
        { name: "Error State", label: "Destructive choices / errors", tint: colors.semantic?.errorBg || "#FEE2E2", base: colors.semantic?.error || "#EF4444", dark: "#7F1D1D" },
        { name: "Info State", label: "Neutral advice & hints", tint: colors.semantic?.infoBg || "#DBEAFE", base: colors.semantic?.info || "#3B82F6", dark: "#1E3A8A" },
      ]

  const lightReport: ContrastRow[] = doc.accessibility?.light?.length ? doc.accessibility.light : cs.lightSurfaceReport || []
  const darkReport: ContrastRow[] = doc.accessibility?.dark?.length ? doc.accessibility.dark : cs.darkSurfaceReport || []
  const darkSurfaceHex = neutral.find((n) => n.weight === "800")?.hex || "#1E293B"
  const guidelines = doc.guidelines || {
    do: cs.do?.[0] || "Ensure warning highlights utilize designated yellow/amber variables stacked with warning-dark text colors to maintain WCAG compliant readability patterns.",
    dont: cs.dont?.[3] || "Do not route primary branding color to denote critical warnings or missing inputs, which confuses global state categorization guidelines.",
  }

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p className="text-xs text-primary font-semibold uppercase tracking-[0.2em]">{doc.category || "02 / FOUNDATION"}</p>
          <h1 className="mt-1 text-2xl sm:text-3xl font-bold" style={SERIF}>{doc.title || "Color System"}</h1>
        </div>
        <div className="flex items-center gap-3">
          <Badge variant="secondary" className="bg-primary/10 text-primary rounded-full text-xs font-bold">{doc.version || d.version || "v2.0.0"}</Badge>
          <span className="text-xs text-muted-foreground">{doc.frame || "Frame 2 of 6"}</span>
        </div>
      </div>
      <Separator />

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h3 className="font-bold text-base">Primary Brand Colors</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Primary calls to action, focus outlines, and active state highlights.</p>
          <div className="mt-4 space-y-3">
            {primaryBrand.map((sw, i) => (
              <div key={i} className="flex items-center gap-4 p-4 rounded-xl border bg-card">
                <div className="h-12 w-12 rounded-lg border shrink-0" style={{ backgroundColor: sw.hex }} />
                <div className="min-w-0">
                  <p className="font-semibold text-sm">{sw.name}</p>
                  <p className="text-xs font-mono text-muted-foreground truncate">
                    {sw.hex}{sw.rgb ? <> · RGB {sw.rgb} · HSL {sw.hsl}</> : null}
                  </p>
                  <p className="text-xs text-muted-foreground mt-0.5">{sw.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 className="font-bold text-base">Secondary Highlights</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Data categories, visual tag markers, and secondary interactive states.</p>
          <div className="mt-4 grid grid-cols-2 gap-3">
            {secondaryHighlights.map((h, i) => (
              <div key={i} className="rounded-xl border bg-card p-3">
                <div className="h-16 rounded-lg border" style={{ backgroundColor: h.hex }} />
                <p className="mt-2 text-xs font-semibold">{h.name}</p>
                <p className="text-[11px] font-mono text-muted-foreground uppercase">{h.hex}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div>
        <h3 className="font-bold text-base">Neutral Palette</h3>
        <p className="text-xs text-muted-foreground mt-0.5">Standard interface surfaces, card borders, text headings, and quiet backgrounds.</p>
        <div className="mt-4 grid grid-cols-6 sm:grid-cols-11 gap-2">
          {neutral.map((n, i) => (
            <div key={i} className="space-y-1.5 text-center">
              <div className="h-16 rounded-lg border" style={{ backgroundColor: n.hex }} />
              <p className="text-xs font-bold">{n.weight}</p>
              <p className="text-[10px] font-mono text-muted-foreground uppercase truncate">{n.hex}</p>
            </div>
          ))}
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h3 className="font-bold text-base">Semantic Colors</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Pre-allocated tracks driving state indicators and feedback alerts.</p>
          <div className="mt-4 space-y-3">
            {semanticColors.map((sem, i) => (
              <div key={i} className="flex items-center justify-between gap-3 p-3 rounded-xl border bg-card">
                <div className="min-w-0">
                  <p className="text-sm font-semibold">{sem.name}</p>
                  <p className="text-xs text-muted-foreground truncate">{sem.label}</p>
                </div>
                <div className="flex items-center gap-1.5 shrink-0">
                  <div className="h-9 w-9 rounded-md border" style={{ backgroundColor: sem.tint }} title={sem.tint} />
                  <div className="h-9 w-9 rounded-md border" style={{ backgroundColor: sem.base }} title={sem.base} />
                  <div className="h-9 w-9 rounded-md border" style={{ backgroundColor: sem.dark }} title={sem.dark} />
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 className="font-bold text-base">Color Accessibility</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Valid contrast ratios tested against WCAG standard rules.</p>
          <div className="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
            {[
              { title: "On Light Surface", hex: "#FFFFFF", text: "#0F172A", report: lightReport },
              { title: "On Dark Surface", hex: darkSurfaceHex, text: "#F8FAFC", report: darkReport },
            ].map((surface, si) => (
              <div key={si} className="rounded-xl border p-4" style={{ backgroundColor: surface.hex }}>
                <div className="flex items-center gap-2 mb-3">
                  <span className="h-4 w-4 rounded border border-black/10" style={{ backgroundColor: surface.hex }} />
                  <p className="text-sm font-bold" style={{ color: surface.text }}>{surface.title}</p>
                </div>
                <div className="space-y-2.5">
                  {surface.report.map((r, i) => (
                    <div key={i} className="flex items-center justify-between gap-3">
                      <span className="text-sm" style={{ color: surface.text }}>{r.sample}</span>
                      <span
                        className={`text-[11px] font-semibold px-2 py-0.5 rounded-full border whitespace-nowrap ${
                          String(r.ratio).includes("Fail")
                            ? "bg-red-100 text-red-700 border-red-200"
                            : String(r.ratio).includes("AAA")
                              ? "bg-emerald-100 text-emerald-700 border-emerald-200"
                              : "bg-green-100 text-green-700 border-green-200"
                        }`}
                      >
                        {r.ratio}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div>
        <h3 className="font-bold text-base">Color Usage Guidelines</h3>
        <div className="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
          <div className="rounded-xl bg-emerald-50/60 border-l-4 border-emerald-500 p-4 dark:bg-emerald-950/40 dark:border-emerald-400">
            <p className="text-sm font-bold text-emerald-800 dark:text-emerald-300 mb-1.5">DO</p>
            <p className="text-sm text-emerald-900 dark:text-emerald-200 leading-relaxed">{guidelines.do}</p>
          </div>
          <div className="rounded-xl bg-red-50/60 border-l-4 border-red-500 p-4 dark:bg-red-950/40 dark:border-red-400">
            <p className="text-sm font-bold text-red-800 dark:text-red-300 mb-1.5">DON&apos;T</p>
            <p className="text-sm text-red-900 dark:text-red-200 leading-relaxed">{guidelines.dont}</p>
          </div>
        </div>
      </div>
    </div>
  )
}

interface TypeScaleRow { style: string; size: string; lineHeight: string; weight: string | number; font?: string; serif?: boolean; uppercase?: boolean; letterSpacing?: string; preview: string }
interface FontFamilyCard { name: string; role: string; sample: string; font: string }
interface FontWeightRow { name: string; value: number }
interface SpacingCard { label: string; value: string; lineHeight?: string; letterSpacing?: string; uppercase?: boolean; description: string }

const DEFAULT_TYPE_SCALE: TypeScaleRow[] = [
  { style: "Display XL", size: "72px", lineHeight: "80px", weight: "700", serif: true, preview: "Apex Visuals" },
  { style: "Header H1", size: "48px", lineHeight: "56px", weight: "700", serif: true, preview: "System Hierarchy Overview" },
  { style: "Header H2", size: "36px", lineHeight: "44px", weight: "600", preview: "Medium scale sub-headings" },
  { style: "Header H3", size: "30px", lineHeight: "38px", weight: "600", preview: "Section container block title" },
  { style: "Header H4", size: "24px", lineHeight: "32px", weight: "500", preview: "Card grouping visual labels" },
  { style: "Header H5", size: "20px", lineHeight: "28px", weight: "500", preview: "Compact card labels and list groups" },
  { style: "Body Large", size: "18px", lineHeight: "26px", weight: "400", preview: "Intro paragraphs and lead-in sentence text styles." },
  { style: "Body Regular", size: "16px", lineHeight: "24px", weight: "400", preview: "Default interactive dashboard table copy, standard paragraphs, and control properties." },
  { style: "Body Small", size: "14px", lineHeight: "20px", weight: "400", preview: "Sub-information text, forms metadata, input hints, and table cell annotations." },
  { style: "Caption", size: "12px", lineHeight: "16px", weight: "500", uppercase: true, preview: "CHART AXIS LABEL, HELPER LEGENDS, MINI METADATA STATS." },
  { style: "Overline", size: "10px", lineHeight: "14px", weight: "600", uppercase: true, letterSpacing: "0.08em", preview: "PRE-ACCENT CATEGORY TAG MARKER" },
]

const DEFAULT_FONT_WEIGHTS: FontWeightRow[] = [
  { name: "Thin", value: 100 }, { name: "Light", value: 300 }, { name: "Regular", value: 400 },
  { name: "Medium", value: 500 }, { name: "SemiBold", value: 600 }, { name: "Bold", value: 700 }, { name: "ExtraBold", value: 800 },
]

const DEFAULT_LINE_HEIGHT: { tight: SpacingCard; normal: SpacingCard } = {
  tight: { label: "TIGHT", value: "115% / 1.15", lineHeight: "1.15", description: "This block shows tight spacing configuration. Good only for short displays or condensed alert tags needing minimum height." },
  normal: { label: "NORMAL", value: "150% / 1.5", lineHeight: "1.5", description: "Standard reading tracking scale used throughout regular document bodies, text blocks, descriptions, and user feedback prompts." },
}

const DEFAULT_LETTER_SPACING: { compact: SpacingCard; wide: SpacingCard } = {
  compact: { label: "COMPACT", value: "-2% / -0.32px", letterSpacing: "-0.32px", description: "Displays headers utilize tight visual tracking." },
  wide: { label: "WIDE", value: "+10% / 1.2px", letterSpacing: "1.2px", uppercase: true, description: "Overlines and badge titles need wider spacing." },
}

function TypographySection({ d }: { d: DesignData }) {
  const doc = d.typographyDoc || {}
  const tokens = d.tokens?.typography || {}
  const headingFont = tokens.headingFont || "'Playfair Display', Georgia, serif"
  const fontFamily = tokens.fontFamily || "Inter, sans-serif"

  const typeScale: TypeScaleRow[] = doc.typeScale?.length ? doc.typeScale : DEFAULT_TYPE_SCALE
  const fontFamilies: FontFamilyCard[] = doc.fontFamilies?.length
    ? doc.fontFamilies
    : [
        { name: "Inter (Sans-Serif)", role: "Primary / Interface Engine", sample: "AbCdEfGhIjKlMnOpQrStUvWxYz 1234567890", font: fontFamily },
        { name: "Playfair Display (Serif)", role: "Secondary / Editorial & display", sample: "AbCdEfGhIjKlMnOpQrStUvWxYz 1234567890", font: headingFont },
        { name: "JetBrains Mono (Monospace)", role: "System / Code & analytical metrics", sample: "const token_id = '#4F46E5';", font: tokens.monoFont || "'JetBrains Mono', monospace" },
      ]
  const fontWeights: FontWeightRow[] = doc.fontWeights?.length ? doc.fontWeights : DEFAULT_FONT_WEIGHTS
  const lineHeight = doc.lineHeight || DEFAULT_LINE_HEIGHT
  const letterSpacing = doc.letterSpacing || DEFAULT_LETTER_SPACING

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p className="text-xs text-primary font-semibold uppercase tracking-[0.2em]">{doc.category || "03 / FOUNDATION"}</p>
          <h1 className="mt-1 text-2xl sm:text-3xl font-bold" style={SERIF}>{doc.title || "Typography & Type Scale"}</h1>
        </div>
        <div className="flex items-center gap-3">
          <Badge variant="secondary" className="bg-primary/10 text-primary rounded-full text-xs font-bold">{doc.version || d.version || "v2.0.0"}</Badge>
          <span className="text-xs text-muted-foreground">{doc.frame || "Frame 3 of 6"}</span>
        </div>
      </div>
      <Separator />

      <div>
        <h3 className="font-bold text-base">System Type Scale</h3>
        <p className="text-xs text-muted-foreground mt-0.5">Structured typography scale optimized for reading pacing and application interface density.</p>
        <div className="mt-4 rounded-xl border divide-y">
          {typeScale.map((t, i) => (
            <div key={i} className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 sm:p-5">
              <div className="sm:w-60 shrink-0">
                <p className="font-semibold text-sm">{t.style}</p>
                <p className="text-[11px] font-mono text-muted-foreground mt-0.5">{t.size} / {t.lineHeight} / {t.weight}</p>
              </div>
              <p
                className="sm:text-right min-w-0"
                style={{
                  fontFamily: t.font || (t.serif ? headingFont : fontFamily),
                  fontSize: t.size,
                  lineHeight: t.lineHeight,
                  fontWeight: t.weight,
                  letterSpacing: t.letterSpacing || "0",
                  textTransform: t.uppercase ? "uppercase" : undefined,
                }}
              >
                {t.preview}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h3 className="font-bold text-base">Font Families</h3>
          <p className="text-xs text-muted-foreground mt-0.5">The system deploys three families mapped specifically to usage context.</p>
          <div className="mt-4 space-y-3">
            {fontFamilies.map((f, i) => (
              <div key={i} className="rounded-xl border bg-card p-4">
                <div className="flex items-center justify-between gap-3">
                  <p className="font-semibold text-sm">{f.name}</p>
                  <span className="text-[11px] text-primary font-medium shrink-0">{f.role}</span>
                </div>
                <p className="mt-3 truncate" style={{ fontFamily: f.font }}>{f.sample}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 className="font-bold text-base">Font Weights</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Weight variants driving reading hierarchy within components.</p>
          <div className="mt-4 rounded-xl border bg-card p-2 divide-y">
            {fontWeights.map((w, i) => (
              <div key={i} className="flex items-center justify-between gap-3 px-3 py-2.5">
                <span className="text-xs text-muted-foreground font-mono w-24 shrink-0">{w.value} · {w.name}</span>
                <span className="text-base truncate" style={{ fontWeight: w.value }}>Typography Structure</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div>
        <h3 className="font-bold text-base">Line Height &amp; Letter Spacing</h3>
        <p className="text-xs text-muted-foreground mt-0.5">Correct spacing is vital to eliminate reading fatigue in long blocks.</p>
        <div className="mt-4 grid grid-cols-1 lg:grid-cols-2 gap-3">
          <div className="space-y-3">
            <div className="rounded-xl border bg-card p-4">
              <div className="flex items-center justify-between">
                <p className="font-bold text-sm">{lineHeight.tight.label}</p>
                <span className="text-[11px] font-mono text-muted-foreground">{lineHeight.tight.value}</span>
              </div>
              <p className="mt-3 text-sm" style={{ lineHeight: lineHeight.tight.lineHeight }}>{lineHeight.tight.description}</p>
            </div>
            <div className="rounded-xl border bg-card p-4">
              <div className="flex items-center justify-between">
                <p className="font-bold text-sm">{lineHeight.normal.label}</p>
                <span className="text-[11px] font-mono text-muted-foreground">{lineHeight.normal.value}</span>
              </div>
              <p className="mt-3 text-sm" style={{ lineHeight: lineHeight.normal.lineHeight }}>{lineHeight.normal.description}</p>
            </div>
          </div>
          <div className="space-y-3">
            <div className="rounded-xl border bg-card p-4">
              <div className="flex items-center justify-between">
                <p className="font-bold text-sm">{letterSpacing.compact.label}</p>
                <span className="text-[11px] font-mono text-muted-foreground">{letterSpacing.compact.value}</span>
              </div>
              <p className="mt-3 text-sm" style={{ letterSpacing: letterSpacing.compact.letterSpacing }}>{letterSpacing.compact.description}</p>
            </div>
            <div className="rounded-xl border bg-card p-4">
              <div className="flex items-center justify-between">
                <p className="font-bold text-sm">{letterSpacing.wide.label}</p>
                <span className="text-[11px] font-mono text-muted-foreground">{letterSpacing.wide.value}</span>
              </div>
              <p
                className="mt-3 text-xs font-bold uppercase"
                style={{ letterSpacing: letterSpacing.wide.letterSpacing, color: "#4F46E5", lineHeight: "1.5" }}
              >
                {letterSpacing.wide.description}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

function SpacingSection({ d }: { d: DesignData }) {
  const spacingScale: number[] = d.spacingLayout?.spacingScale || d.tokens?.spacing?.scale || []
  const spacingNames: string[] = d.spacingLayout?.spacingNames || d.tokens?.spacing?.names || []
  const baseUnit = d.spacingLayout?.baseUnit || d.tokens?.spacing?.baseUnit || 4
  const radiusScale: Record<string, string> = d.tokens?.radiusScale || d.spacingLayout?.radiusScale || {}
  const avatar = d.tokens?.sizing?.avatar || {}
  const inputHeights = d.tokens?.sizing?.inputHeights || {}
  const button = d.tokens?.sizing?.button || {}
  const card = d.tokens?.sizing?.card || {}

  const spacingRows = spacingScale.slice(1).map((v: number, i: number) => ({
    token: spacingNames[i + 1] || `Space ${i + 1}`,
    value: v,
  }))

  const RADIUS_ORDER = [
    { key: "none", desc: "sharp corners" },
    { key: "sm", desc: "slightly rounded corners" },
    { key: "md", desc: "standard rounding" },
    { key: "lg", desc: "card/input rounding" },
    { key: "xl", desc: "dashboard card rounding" },
    { key: "2xl", desc: "large banner/container rounding" },
    { key: "full", desc: "capsule/pill rounding" },
  ]

  const avatarRamp = [
    { label: "24px", value: avatar.xxs },
    { label: "32px", value: avatar.xs },
    { label: "40px", value: avatar.sm },
    { label: "48px", value: avatar.md },
    { label: "64px", value: avatar.lg },
  ]

  const inputRows = [
    { label: "Small", token: "sm", value: inputHeights.sm },
    { label: "Default", token: "md", value: inputHeights.default },
    { label: "Large", token: "lg", value: inputHeights.lg },
  ]

  const buttonSpecs = [
    { label: "Horizontal padding", value: button.horizontalPadding, token: "Space 5" },
    { label: "Vertical padding", value: button.verticalPadding, token: "Space 3" },
    { label: "Inner Spacing", value: button.innerSpacing, token: "Space 2" },
  ]

  const cardSpecs = [
    { label: "Uniform Padding", value: card.padding, token: "Space 6" },
    { label: "Header to content gap", value: card.headerGap, token: "Space 3" },
    { label: "Card corner radius", value: card.radius, token: "Radius xl" },
  ]

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p className="text-xs text-primary font-semibold uppercase tracking-[0.2em]">04 / FOUNDATION</p>
          <h1 className="mt-1 text-2xl sm:text-3xl font-bold" style={SERIF}>Spacing &amp; Sizing Scales</h1>
        </div>
        <div className="flex items-center gap-3">
          <Badge variant="secondary" className="bg-primary/10 text-primary rounded-full text-xs font-bold">{d.version || "v2.0.0"}</Badge>
          <span className="text-xs text-muted-foreground">Frame 4 of 6</span>
        </div>
      </div>
      <Separator />

      <div>
        <h3 className="font-bold text-base">Visual Spacing Scale</h3>
        <p className="text-xs text-muted-foreground mt-0.5">Base {baseUnit}px sizing units governing components gaps, paddings, margins.</p>
        <div className="mt-4 rounded-xl border bg-card p-5 space-y-3">
          {spacingRows.map((r) => (
            <div key={r.token} className="flex items-center gap-4">
              <div className="w-28 shrink-0">
                <p className="font-semibold text-sm">{r.token}</p>
                <p className="text-xs font-mono text-muted-foreground">{r.value}px</p>
              </div>
              <div className="h-3.5 rounded-sm bg-primary" style={{ width: `${r.value}px` }} />
            </div>
          ))}
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h3 className="font-bold text-base">Standard Sizing Tokens</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Assigned target measurements for layout elements and interface nodes.</p>
          <div className="mt-4 rounded-xl border bg-card p-5 space-y-6">
            <div>
              <p className="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-3">Avatar Sizing Ramp</p>
              <div className="flex items-end gap-4">
                {avatarRamp.map((a) => (
                  <div key={a.label} className="flex flex-col items-center gap-2">
                    <div
                      className="rounded-full border border-primary/30 bg-primary/10"
                      style={{ width: a.value, height: a.value }}
                    />
                    <span className="text-xs font-mono text-muted-foreground">{a.label}</span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <p className="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground mb-2">Form Inputs Heights</p>
              <div className="space-y-2">
                {inputRows.map((row) => (
                  <div
                    key={row.token}
                    className="flex items-center justify-between rounded-md border px-3"
                    style={{ height: row.value }}
                  >
                    <span className="text-sm font-medium">{row.label}</span>
                    <span className="text-xs text-muted-foreground">{row.token}: {row.value}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div>
          <h3 className="font-bold text-base">Border Radius Scale</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Corner styling rules shaping surfaces geometry.</p>
          <div className="mt-4 rounded-xl border bg-card p-5 space-y-3">
            {RADIUS_ORDER.map((rad) => {
              const val = radiusScale[rad.key] || "0px"
              return (
                <div key={rad.key} className="flex items-center justify-between gap-3">
                  <div className="min-w-0">
                    <p className="text-sm font-semibold font-mono">{rad.key} ({val})</p>
                    <p className="text-xs text-muted-foreground">{rad.desc}</p>
                  </div>
                  <div
                    className="h-6 w-20 rounded-md border border-primary/40 bg-primary/10 shrink-0"
                    style={{ borderRadius: val }}
                  />
                </div>
              )
            })}
          </div>
        </div>
      </div>

      <div>
        <h3 className="font-bold text-base">Padding &amp; Layout Scaffolding Rules</h3>
        <p className="text-xs text-muted-foreground mt-0.5">Standard spacing applications on regular component patterns.</p>
        <div className="mt-4 grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div className="rounded-xl border bg-card p-5">
            <button className="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-medium text-primary-foreground">
              + Action CTA
            </button>
            <ul className="mt-4 space-y-3">
              {buttonSpecs.map((s) => (
                <li key={s.label} className="flex items-center justify-between gap-3 text-sm border-t pt-3">
                  <span>{s.label}</span>
                  <span className="text-muted-foreground">{s.value} ({s.token})</span>
                </li>
              ))}
            </ul>
          </div>
          <div className="rounded-xl border bg-card p-5">
            <div className="rounded-xl border bg-muted p-4">
              <p className="font-bold text-sm">Card Title Header</p>
              <p className="text-xs text-muted-foreground mt-1">Full body contents and details tracking. Inside margins ensure alignment.</p>
            </div>
            <ul className="mt-4 space-y-3">
              {cardSpecs.map((s) => (
                <li key={s.label} className="flex items-center justify-between gap-3 text-sm border-t pt-3">
                  <span>{s.label}</span>
                  <span className="text-muted-foreground">{s.value} ({s.token})</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  )
}

function GridSection({ d }: { d: DesignData }) {
  const grid = d.tokens?.grid || {}
  const containers = grid.maxWidthContainers || {}
  const breakpointData = grid.breakpoints || d.spacingLayout?.breakpoints || {}

  const breakpointOrder = ["xs", "sm", "md", "lg", "xl", "2xl"]
  const breakpointLabels: Record<string, string> = {
    xs: "Mobile Portrait",
    sm: "Mobile Landscape",
    md: "Tablet Portrait",
    lg: "Tablet Landscape / Laptop",
    xl: "Desktop standard",
    "2xl": "Large Desktop screens",
  }

  const breakpoints = breakpointOrder.map((key) => ({
    key,
    label: breakpointLabels[key] || key,
    min: key === "xs" ? 0 : parseInt(String(breakpointData[key] || "0"), 10),
  }))

  const breakpointRows = breakpoints.map((bp, i) => {
    const next = breakpoints[i + 1]
    const range = next ? `${bp.min}px - ${next.min - 1}px` : `${bp.min}px +`
    return { ...bp, range }
  })

  const containerOrder = ["640px", "768px", "1024px", "1280px", "1536px"]
  const containerClass: Record<string, string> = {
    "640px": "Max-sm", "768px": "Max-md", "1024px": "Max-lg", "1280px": "Max-xl", "1536px": "Max-2xl",
  }
  const containerRows = containerOrder.map((key) => ({
    className: containerClass[key] || `Max-${key}`,
    width: key,
    usage: containers[key]?.usage || "",
  }))

  const patterns = [
    { name: "Single Column", layout: [{ grow: 1 }] },
    { name: "Sidebar + Main", layout: [{ width: "25%" }, { grow: 1 }] },
    { name: "2-Column Equal", layout: [{ grow: 1 }, { grow: 1 }] },
    { name: "3-Column Dash", layout: [{ width: "20%" }, { grow: 1 }, { width: "20%" }] },
  ]

  const systemLabel = containers.fluid?.usage || "System: Fluid Center"

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p className="text-xs text-primary font-semibold uppercase tracking-[0.2em]">05 / FOUNDATION</p>
          <h1 className="mt-1 text-2xl sm:text-3xl font-bold" style={SERIF}>Grid &amp; Responsive Layout</h1>
        </div>
        <div className="flex items-center gap-3">
          <Badge variant="secondary" className="bg-primary/10 text-primary rounded-full text-xs font-bold">{d.version || "v2.0.0"}</Badge>
          <span className="text-xs text-muted-foreground">Frame 5 of 6</span>
        </div>
      </div>
      <Separator />

      <div>
        <h3 className="font-bold text-base">12-Column Grid System Structure</h3>
        <p className="text-xs text-muted-foreground mt-0.5">Dynamic page grid configurations matching layout constraints.</p>
        <div className="mt-4 rounded-xl border bg-card p-5">
          <p className="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">Desktop (1440px) Grid representation</p>
          <div className="flex gap-2">
            {Array.from({ length: grid.columns || 12 }).map((_, i) => (
              <div key={i} className="h-12 flex-1 rounded-md border border-primary/25 bg-primary/10" />
            ))}
          </div>
          <div className="mt-4 grid grid-cols-3 gap-4 border-t pt-4">
            <div>
              <p className="text-xs font-semibold">Margins</p>
              <p className="text-sm text-muted-foreground font-mono">{grid.margins?.desktop || "80px"}</p>
            </div>
            <div>
              <p className="text-xs font-semibold">Gutter width</p>
              <p className="text-sm text-muted-foreground font-mono">{grid.gutter || "24px"}</p>
            </div>
            <div>
              <p className="text-xs font-semibold">System</p>
              <p className="text-sm text-muted-foreground font-mono">{systemLabel}</p>
            </div>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
          <h3 className="font-bold text-base">Breakpoint Grid Rules</h3>
          <p className="text-xs text-muted-foreground mt-0.5">The standard breakpoints scale powering device adaptations.</p>
          <div className="mt-4 rounded-xl border bg-card p-5 space-y-3">
            {breakpointRows.map((b) => (
              <div key={b.key} className="flex items-center justify-between gap-3">
                <div className="flex items-center gap-2.5">
                  <Badge variant="secondary" className="text-[10px] font-mono uppercase">{b.key}</Badge>
                  <span className="text-sm">{b.label}</span>
                </div>
                <span className="text-sm text-muted-foreground font-mono text-right">{b.range}</span>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 className="font-bold text-base">Max-Width Containers</h3>
          <p className="text-xs text-muted-foreground mt-0.5">Page limits avoiding endless line lengths.</p>
          <div className="mt-4 rounded-xl border bg-card p-5 space-y-3">
            {containerRows.map((c) => (
              <div key={c.className} className="flex items-center justify-between gap-3">
                <span className="text-sm font-semibold font-mono text-primary">{c.className}: <span className="text-primary">{c.width}</span></span>
                <span className="text-sm text-muted-foreground text-right">{c.usage}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div>
        <h3 className="font-bold text-base">Canonical Layout Patterns</h3>
        <p className="text-xs text-muted-foreground mt-0.5">Standard layouts models structured inside columns.</p>
        <div className="mt-4 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
          {patterns.map((p) => (
            <div key={p.name} className="rounded-xl border bg-card p-4">
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">{p.name}</p>
              <div className="flex gap-2 h-8">
                {p.layout.map((col, i) => (
                  <div
                    key={i}
                    className="h-8 rounded-md bg-muted"
                    style={col.grow ? { flexGrow: col.grow } : { width: col.width as string }}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

