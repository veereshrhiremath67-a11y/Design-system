                <p className="text-xs font-bold text-slate-800">{lv.level}</p>
                <p className="text-sm text-muted-foreground leading-relaxed">{lv.usage}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div className="space-y-6">
          <div>
            <h3 className="font-bold text-base">Border Styles</h3>
            <p className="text-xs text-muted-foreground mt-0.5">Solid and pattern constraints.</p>
            <div className="mt-4 grid grid-cols-2 gap-3">
              {BORDER_STYLES.map((b) => (
                <div key={b.label} className={`flex items-center justify-center rounded-lg p-4 text-sm font-medium text-slate-700 ${b.className}`}>
                  {b.label}
                </div>
              ))}
            </div>
          </div>

          <div>
            <h3 className="font-bold text-base">Dividers</h3>
            <p className="text-xs text-muted-foreground mt-0.5">Separation layouts.</p>
            <div className="mt-4 rounded-xl border bg-white p-6 space-y-6">
              <div className="h-px w-full bg-[#E2E8F0]" />
              <div className="mx-auto h-px w-24 bg-[#E2E8F0]" />
              <div className="flex items-center gap-3">
                <div className="h-px flex-1 bg-[#E2E8F0]" />
                <span className="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">OR CONTINUE WITH</span>
                <div className="h-px flex-1 bg-[#E2E8F0]" />
              </div>
            </div>
          </div>
        </div>

        <div className="space-y-6">
          <div>
            <h3 className="font-bold text-base">Focus Rings</h3>
            <p className="text-xs text-muted-foreground mt-0.5">Aesthetics of active keyboard interaction.</p>
            <div className="mt-4 rounded-xl border bg-white p-6 flex flex-col sm:flex-row items-center gap-5">
              <div className="rounded-md p-1">
                <button className="rounded-md bg-[#2563EB] px-5 py-2.5 text-sm font-medium text-white" style={{ outline: "3px solid #93C5FD", outlineOffset: "2px" }}>
                  Primary Action
                </button>
              </div>
              <p className="text-sm text-muted-foreground leading-relaxed">Highlighted by 3px outer stroke with 1px internal spacer.</p>
            </div>
          </div>

          <div>
            <h3 className="font-bold text-base">Surface Hierarchy</h3>
            <p className="text-xs text-muted-foreground mt-0.5">Z-index abstraction model.</p>
            <div className="mt-4 relative flex h-40 items-center justify-center rounded-xl bg-[#F1F5F9] p-8">
              {SURFACE_LAYERS.map((s, i) => (
                <div
                  key={s.name}
                  className={`absolute flex w-64 items-center justify-between gap-3 rounded-lg bg-white px-5 py-4 ${s.className}`}
                  style={{
                    boxShadow: s.shadow,
                    zIndex: i,
                    transform: i === 0 ? "translateX(-28px) translateY(14px)" : i === 1 ? "translateX(0) translateY(6px)" : "translateX(28px)",
                  }}
                >
                  <p className="text-sm font-semibold text-slate-800">{s.name}</p>
                  <span className={`text-[10px] font-semibold rounded-full px-2 py-0.5 ${i === 2 ? "text-[#2563EB]" : "text-muted-foreground"} bg-slate-100`}>
                    {s.tag}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

function DataVizSection({ d }: { d: DesignData }) {
  const dv = d.dataViz || {}
  return (
    <div className="space-y-4">
      <SectionHeader title="Data Visualization" description="Chart palettes, graph specs, and compliance for data-heavy interfaces" icon={BarChart3} />

