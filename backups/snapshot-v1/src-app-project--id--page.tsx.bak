  { name: "Surface Card", tag: "Level 1", className: "ring-1 ring-[#E2E8F0]", shadow: "0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px 0 rgba(0, 0, 0, 0.03)" },
  { name: "Overlay State", tag: "Level 3", className: "border-2 border-[#2563EB]", shadow: "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)" },
]

