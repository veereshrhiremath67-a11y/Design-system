# Supabase Postgres connection string.
# "Copy connection string" in Supabase -> Project Settings -> Database -> URI.
# Use the "transaction/pooler" or direct URI (add ?sslmode=require for Prisma).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# NextAuth v5 secret: long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Required on Vercel (trusting the deployment host).
AUTH_TRUST_HOST="true"

# Public URL of the app (used for any absolute links / callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"